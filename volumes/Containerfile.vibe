# Mistral Vibe CLI standalone binary as of 2026-10-17: 2.26.1.
# The release zip is a PyInstaller bundle: the vibe executable requires its
# sibling _internal directory, so both are unpacked into bin/ together.
from ghcr.io/erikbergsten/dev-volumes/builder:0.1.0 as build-arm64

run apt update -y && apt install -y unzip
run curl -fL --retry 3 -o /tmp/vibe.zip "https://github.com/mistralai/mistral-vibe/releases/download/v2.26.1/vibe-linux-aarch64-2.26.1.zip"
run printf '%s  %s\n' 'bab9ea63437440e819174269f2d192c076380b3026af29f435e1f5018f1f363c' /tmp/vibe.zip | sha256sum -c -
run mkdir -p /build/vibe/bin && unzip -q /tmp/vibe.zip -d /build/vibe/bin
run /build/vibe/bin/vibe --version

from ghcr.io/erikbergsten/dev-volumes/builder:0.1.0 as build-amd64

run apt update -y && apt install -y unzip
run curl -fL --retry 3 -o /tmp/vibe.zip "https://github.com/mistralai/mistral-vibe/releases/download/v2.26.1/vibe-linux-x86_64-2.26.1.zip"
run printf '%s  %s\n' '2915db76b12d31589706a3e1c5aac41de32fa6a12d7b2e694df0dd540c09127e' /tmp/vibe.zip | sha256sum -c -
run mkdir -p /build/vibe/bin && unzip -q /tmp/vibe.zip -d /build/vibe/bin
run /build/vibe/bin/vibe --version

arg TARGETARCH
from build-${TARGETARCH} as build

from scratch
copy --from=build /build/vibe/bin/ /bin/
